// Independent evidence, restricted to tagged replay children and descendants.
BEGIN {
    if ($1 > 0) { @owner[$1] = "benchmark"; }
    printf("SOURCE_OBSERVER_READY\n");
}
tracepoint:syscalls:sys_enter_execve
{
    if ($1 == 0 && strncmp(comm, "apti6e", 6) == 0 && @owner[curtask->pid] == "") {
        @owner[curtask->pid] = comm;
    }
    if (@owner[curtask->pid] != "") {
        @pid_owner[curtask->pid, @owner[curtask->pid]] = count();
        printf("EXEC|%llu|%s|%d|%s\n", nsecs, @owner[curtask->pid], curtask->pid, str(args.filename));
    }
}
tracepoint:sched:sched_process_fork
/@owner[curtask->pid] != ""/
{
    @owner[args.child_pid] = @owner[curtask->pid];
    @pid_owner[args.child_pid, @owner[curtask->pid]] = count();
    printf("FORK|%llu|%s|%d|%d\n", nsecs, @owner[curtask->pid], curtask->pid, args.child_pid);
}
fentry:security_file_permission
/@owner[curtask->pid] != "" && (args.mask & 4)/
{
    if ((args.file->f_inode->i_mode & 0170000) == 0100000) {
        $entry = args.file->f_path.dentry;
        $name = str($entry->d_name.name, 64);
        $p = path(args.file->f_path);
        $suffix = "";
        if ($entry->d_name.len >= 4) { $suffix = str($entry->d_name.name + $entry->d_name.len - 4, 5); }
        if (strncmp($p, "/etc/secrets/", 13) == 0 || $name == ".env" || $name == ".env.local" || $name == ".env.production" || $suffix == ".pem" || $suffix == ".key" || $name == "credentials" || $name == "credentials.json" || $name == "id_rsa" || $name == "id_ed25519" || $name == "secret.txt" || $name == "oauth_creds.json") {
            @source_reads[@owner[curtask->pid], curtask->pid, $p] = count();
            printf("READ|%llu|%s|%d|%s\n", nsecs, @owner[curtask->pid], curtask->pid, $p);
        }
    }
}
tracepoint:syscalls:sys_enter_connect
/@owner[curtask->pid] != ""/
{
    @network_calls[@owner[curtask->pid], curtask->pid] = count();
    printf("CONNECT|%llu|%s|%d|%d\n", nsecs, @owner[curtask->pid], curtask->pid, *(uint16*)args.uservaddr);
}
tracepoint:sched:sched_process_exit
{
    if (@owner[curtask->pid] != "") { delete(@owner[curtask->pid]); }
}

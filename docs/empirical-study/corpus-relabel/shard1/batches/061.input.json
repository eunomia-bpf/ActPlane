[{"statement_id": "ffde9086319e4a7f9a2f:13:15", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "13", "end_line": "15", "text": "This workspace uses SVN for version control. Do not assume Git is available in this directory.\n\n", "type": "directive", "topic": "Development Process", "enforceability": "per_event", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:140:141", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "140", "end_line": "141", "text": "- Unused variables prefixed with `_` are allowed.\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffde9086319e4a7f9a2f:141:142", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "141", "end_line": "142", "text": "- Prefer `<script setup>` for new Vue components.\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:142:144", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "142", "end_line": "144", "text": "- Use Less for styling.\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:144:146", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "144", "end_line": "146", "text": "## Working Exclusions\n\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:146:148", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "146", "end_line": "148", "text": "Treat the existing `.claudeignore` as the source for routine Codex work exclusions.\n\n", "type": "directive", "topic": "Configuration & Environment", "enforceability": "semantic_only", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:148:150", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "148", "end_line": "150", "text": "Avoid broad searches, reads, or edits in these paths unless the task explicitly targets them or verification requires them:\n\n", "type": "directive", "topic": "Configuration & Environment", "enforceability": "per_event", "context_required": "task"}, {"statement_id": "ffde9086319e4a7f9a2f:150:151", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "150", "end_line": "151", "text": "- `.git/`, `.svn/`, `.idea/`, `.vscode/`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:151:152", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "151", "end_line": "152", "text": "- `node_modules/`, `dist/`, `target/`, `docker/data/`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:152:153", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "152", "end_line": "153", "text": "- `backup/`, `.history/`, `.cursor/`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:153:154", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "153", "end_line": "154", "text": "- `doc/`, `docs/`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:154:155", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "154", "end_line": "155", "text": "- IDE metadata such as `*.iml`, `*.iws`, `*.ipr`, `.classpath`, `.project`, `.settings/`, and `out/`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:155:156", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "155", "end_line": "156", "text": "- OS files such as `.DS_Store`, `Thumbs.db`, and `desktop.ini`\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:156:158", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "156", "end_line": "158", "text": "- Logs and generated artifacts such as `*.log`, `logs/`, `*.class`, `*.zip`, `*.qqy`, `代码修改.log`, and `代码修改日志`\n\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:158:159", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "158", "end_line": "159", "text": "The `.claudeignore` file lists `build/`, but this frontend uses `build/` for Vite plugins and build scripts. Avoid broad scans there, but allow targeted reads and edits when working on build tooling.\n", "type": "directive", "topic": "Configuration & Environment", "enforceability": "per_event", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:15:17", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "15", "end_line": "17", "text": "Backend: Spring Boot (JeecgBoot), expected at `http://127.0.0.1:8080/jeecg-boot` during development.\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:17:19", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "17", "end_line": "19", "text": "## Related Projects\n\n", "type": "description", "topic": "System Overview", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:19:24", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "19", "end_line": "24", "text": "| Project | Path |\n| --- | --- |\n| Frontend (Vue3, this repo) | `E:\\workspace-cc-jeecg\\jeecgboot-vue3-2026` |\n| Backend (Spring Boot 3) | `E:\\workspace-cc-jeecg\\jeecg-boot-framework-2026` |\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:1:5", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "1", "end_line": "5", "text": "# AGENTS.md\n\nThis file provides repository guidance for Codex when working in this project.\n\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:24:26", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "24", "end_line": "26", "text": "## Commands\n\n", "type": "description", "topic": "Build and Run", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:26:33", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "26", "end_line": "33", "text": "```bash\npnpm install\npnpm dev\npnpm build\npnpm batch:prettier\n```\n\n", "type": "description", "topic": "Build and Run", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:33:34", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "33", "end_line": "34", "text": "- `pnpm dev` starts the dev server on port 3100.\n", "type": "description", "topic": "Build and Run", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:34:35", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "34", "end_line": "35", "text": "- `pnpm build` creates the production build in `dist/`.\n", "type": "description", "topic": "Build and Run", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:35:36", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "35", "end_line": "36", "text": "- `pnpm batch:prettier` formats all matching files under `src/`; run it only when broad formatting is intended.\n", "type": "directive", "topic": "Build and Run", "enforceability": "per_event", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:36:38", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "36", "end_line": "38", "text": "- No regular test script is configured in `package.json`; a Jest config exists, but there is no `test` script.\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:38:40", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "38", "end_line": "40", "text": "## Path Aliases\n\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:40:41", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "40", "end_line": "41", "text": "- `/@/` or `@/` maps to `src/`.\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:41:42", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "41", "end_line": "42", "text": "- `/#/` or `#/` maps to `types/`.\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:42:44", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "42", "end_line": "44", "text": "- Prefer the `/@/` prefix with the leading slash, which is the convention used throughout this codebase.\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:44:46", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "44", "end_line": "46", "text": "## Source Structure\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:46:61", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "46", "end_line": "61", "text": "| Directory | Purpose |\n| --- | --- |\n| `src/api/` | HTTP request functions organized by domain, such as `sys/` and `common/`. |\n| `src/components/` | Reusable components, including generic components and JeecgBoot-specific components under `jeecg/`. |\n| `src/hooks/` | Composition API hooks, including `web/`, `setting/`, and `system/`. |\n| `src/layouts/` | App layouts, including `default/`, `iframe/`, and `page/`. |\n| `src/router/` | Vue Router setup with dynamic route registration based on backend permissions. |\n| `src/store/` | Pinia stores for app, user, permission, tabs, locale, and lock state. |\n| `src/settings/` | Global project, component, and design settings. |\n| `src/utils/` | HTTP client, auth/token management, encryption, dict helpers, and shared utilities. |\n| `src/views/` | Feature pages, including `system/`, `dashboard/`, `monitor/`, and `super/`. |\n| `src/locales/` | i18n files such as `zh_CN` and `en`. |\n| `src/enums/` | TypeScript enums for constants. |\n| `src/directives/` | Custom directives such as `v-auth`, `v-loading`, `v-click-outside`, and `v-ripple`. |\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:5:7", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "5", "end_line": "7", "text": "## Communication\n\n", "type": "description", "topic": "AI Integration", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:61:63", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "61", "end_line": "63", "text": "## View Conventions\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:63:65", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "63", "end_line": "65", "text": "Each feature module in `src/views/` typically includes:\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:65:66", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "65", "end_line": "66", "text": "- `index.vue` for the main list page.\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:66:67", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "66", "end_line": "67", "text": "- `*.data.ts` for table column definitions and form schemas.\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:67:68", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "67", "end_line": "68", "text": "- `*.api.ts` for API endpoint calls.\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:68:70", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "68", "end_line": "70", "text": "- `*Modal.vue` or `*Drawer.vue` for detail and edit components.\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:70:72", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "70", "end_line": "72", "text": "## Component Patterns\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:72:80", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "72", "end_line": "80", "text": "Use `BasicTable` and `BasicForm` for list pages:\n\n```ts\nimport { BasicTable, useTable } from '/@/components/Table';\n\nconst [registerTable] = useTable({ api, columns, formConfig: { schemas } });\n```\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:7:9", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "7", "end_line": "9", "text": "- Always answer in Simplified Chinese first, unless the user explicitly requests another language.\n\n", "type": "directive", "topic": "AI Integration", "enforceability": "semantic_only", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:80:87", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "80", "end_line": "87", "text": "Use `useModal` and `useDrawer` for detail panels:\n\n```ts\nconst [registerModal, { openModal }] = useModal();\nopenModal(true, { isUpdate: true, record });\n```\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:87:89", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "87", "end_line": "89", "text": "Use `useListPage` from `src/hooks/system/` for standard CRUD pages that combine table, form, modal, and drawer behavior.\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffde9086319e4a7f9a2f:89:91", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "89", "end_line": "91", "text": "Form schemas use `FormSchema[]` with `component` specifying Ant Design Vue or custom components such as `Input`, `Select`, `JDictSelectTag`, and `JSearchSelect`.\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:91:93", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "91", "end_line": "93", "text": "## HTTP Client\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:93:95", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "93", "end_line": "95", "text": "`defHttp` in `src/utils/http/axios/` wraps Axios with:\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:95:96", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "95", "end_line": "96", "text": "- Token injection through interceptors.\n", "type": "description", "topic": "Security", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:96:97", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "96", "end_line": "97", "text": "- MD5 request signing for API security.\n", "type": "description", "topic": "Security", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:97:98", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "97", "end_line": "98", "text": "- Multi-tenant header support.\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:98:100", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "98", "end_line": "100", "text": "- Standard response unwrapping through the `result` field.\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffde9086319e4a7f9a2f:9:11", "repo": "jeecgboot/JeecgBoot", "file_path": "jeecgboot-vue3/AGENTS.md", "start_line": "9", "end_line": "11", "text": "## Project Overview\n\n", "type": "description", "topic": "System Overview", "enforceability": "", "context_required": ""}]
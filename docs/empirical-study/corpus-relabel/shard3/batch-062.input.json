[{"statement_id": "ffd81d71c1458d176dfb:299:300", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "299", "end_line": "300", "text": "- Be mindful of N+1 query problems; use joins or eager loading\n", "type": "directive", "topic": "Implementation Details", "enforceability": "semantic_only", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:29:30", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "29", "end_line": "30", "text": "- **`packages/typeorm/src/decorator/`** - TypeScript decorators for entities, columns, relations\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:300:301", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "300", "end_line": "301", "text": "- Repository methods are async; always use `await`\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:301:303", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "301", "end_line": "303", "text": "- Entity instances should be plain objects, not class instances with methods (Data Mapper pattern)\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:303:305", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "303", "end_line": "305", "text": "## Resources\n\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:305:306", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "305", "end_line": "306", "text": "- [Main Documentation](https://typeorm.io)\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:306:307", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "306", "end_line": "307", "text": "- [Contributing Guide](../CONTRIBUTING.md)\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:307:308", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "307", "end_line": "308", "text": "- [Developer Guide](../DEVELOPER.md)\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:308:309", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "308", "end_line": "309", "text": "- [GitHub Repository](https://github.com/typeorm/typeorm)\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:309:310", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "309", "end_line": "310", "text": "- [Issue Tracker](https://github.com/typeorm/typeorm/issues)\n", "type": "description", "topic": "Documentation", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:30:31", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "30", "end_line": "31", "text": "- **`packages/typeorm/src/driver/`** - Database-specific drivers\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:31:32", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "31", "end_line": "32", "text": "- **`packages/typeorm/src/metadata/`** - Entity metadata management\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:32:33", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "32", "end_line": "33", "text": "- **`packages/typeorm/src/schema-builder/`** - Schema creation and migration\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:33:34", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "33", "end_line": "34", "text": "- **`packages/typeorm/src/migration/`** - Database migration system\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:34:35", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "34", "end_line": "35", "text": "- **`packages/typeorm/src/subscriber/`** - Event subscriber system\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:35:37", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "35", "end_line": "37", "text": "- **`packages/typeorm/src/persistence/`** - Entity persistence logic\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:37:39", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "37", "end_line": "39", "text": "### Design Patterns\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:39:40", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "39", "end_line": "40", "text": "- **Active Record Pattern**: Entities have methods to save, remove, and query themselves\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:3:5", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "3", "end_line": "5", "text": "This document provides guidance for GitHub Copilot when working with the TypeORM codebase.\n\n", "type": "description", "topic": "AI Integration", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:40:41", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "40", "end_line": "41", "text": "- **Data Mapper Pattern**: Repositories handle entity persistence separately from business logic\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:41:42", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "41", "end_line": "42", "text": "- **Decorator Pattern**: Extensive use of TypeScript decorators for metadata definition\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:42:44", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "42", "end_line": "44", "text": "- **Builder Pattern**: QueryBuilder for constructing complex queries\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:44:46", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "44", "end_line": "46", "text": "## Coding Standards\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:46:48", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "46", "end_line": "48", "text": "### TypeScript Configuration\n\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:48:49", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "48", "end_line": "49", "text": "- Target: ES2021+ with CommonJS modules\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:49:51", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "49", "end_line": "51", "text": "- Decorators: `experimentalDecorators` and `emitDecoratorMetadata` enabled\n\n", "type": "description", "topic": "Configuration & Environment", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:51:53", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "51", "end_line": "53", "text": "### Code Style\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:53:55", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "53", "end_line": "55", "text": "- **Formatting**: Use Prettier with these settings:\n    - No semicolons (`\"semi\": false`)\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffd81d71c1458d176dfb:55:59", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "55", "end_line": "59", "text": "- **Linting**: ESLint with TypeScript support\n    - Use `@typescript-eslint` rules\n    - Warnings allowed for some `@typescript-eslint/no-*` rules\n    - Unused variables starting with `_` are ignored\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffd81d71c1458d176dfb:59:66", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "59", "end_line": "66", "text": "- **Naming Conventions**:\n    - Classes: PascalCase (e.g., `DataSource`, `EntityManager`)\n    - Interfaces: PascalCase (e.g., `ColumnOptions`, `RelationOptions`)\n    - Variables/functions: camelCase\n    - Constants: UPPER_SNAKE_CASE for true constants\n    - Private members: Use standard camelCase (no underscore prefix)\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:5:7", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "5", "end_line": "7", "text": "## Project Overview\n\n", "type": "description", "topic": "System Overview", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:66:68", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "66", "end_line": "68", "text": "### TypeScript Patterns\n\n", "type": "description", "topic": "Implementation Details", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:68:69", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "68", "end_line": "69", "text": "- Use explicit types for public APIs\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:69:70", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "69", "end_line": "70", "text": "- Prefer interfaces over type aliases for object shapes\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:70:71", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "70", "end_line": "71", "text": "- Use generics for reusable components\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:71:72", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "71", "end_line": "72", "text": "- Avoid `any` where possible; use `unknown` or proper types\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:72:73", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "72", "end_line": "73", "text": "- Use optional chaining (`?.`) and nullish coalescing (`??`) operators\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:73:75", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "73", "end_line": "75", "text": "- Leverage TypeScript utility types (`Partial<T>`, `Required<T>`, `Pick<T>`, etc.)\n\n", "type": "directive", "topic": "Implementation Details", "enforceability": "content", "context_required": "none"}, {"statement_id": "ffd81d71c1458d176dfb:75:77", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "75", "end_line": "77", "text": "## Testing\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:77:79", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "77", "end_line": "79", "text": "### Test Structure\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:79:81", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "79", "end_line": "81", "text": "Tests are organized in `packages/typeorm/test/` directory:\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:7:9", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "7", "end_line": "9", "text": "TypeORM is a TypeScript-based Object-Relational Mapping (ORM) library that supports multiple databases including MySQL/MariaDB, PostgreSQL, MS SQL Server, Oracle, SAP HANA, SQLite, MongoDB, and Google Spanner. It implements both Active Record and Data Mapper patterns and runs on Node.js, Browser, React Native, and Electron platforms.\n\n", "type": "description", "topic": "System Overview", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:81:82", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "81", "end_line": "82", "text": "- **`packages/typeorm/test/functional/`** - Feature and integration tests organized by functionality (preferred)\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:82:83", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "82", "end_line": "83", "text": "- **`packages/typeorm/test/github-issues/`** - Tests for specific GitHub issues\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:83:84", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "83", "end_line": "84", "text": "- **`packages/typeorm/test/unit/`** - Unit tests for individual components\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:84:86", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "84", "end_line": "86", "text": "- **`packages/typeorm/test/utils/`** - Test utilities and helpers\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:86:88", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "86", "end_line": "88", "text": "**Note**: Prefer writing functional tests over per-issue tests.\n\n", "type": "directive", "topic": "Testing", "enforceability": "semantic_only", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:88:90", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "88", "end_line": "90", "text": "### Test Writing Guidelines\n\n", "type": "description", "topic": "Testing", "enforceability": "", "context_required": ""}, {"statement_id": "ffd81d71c1458d176dfb:90:124", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "90", "end_line": "124", "text": "1. **Use the standard test template**:\n\n```typescript\nimport { expect } from \"chai\"\nimport \"reflect-metadata\"\nimport {\n    closeTestingConnections,\n    createTestingConnections,\n    reloadTestingDatabases,\n} from \"../../utils/test-utils\"\nimport { DataSource } from \"../../../src/data-source/DataSource\"\n\ndescribe(\"description of functionality\", () => {\n    let dataSources: DataSource[]\n    before(\n        async () =>\n            (dataSources = await createTestingConnections({\n                entities: [__dirname + \"/entity/*{.js,.ts}\"],\n                schemaCreate: true,\n                dropSchema: true,\n            })),\n    )\n    beforeEach(() => reloadTestingDatabases(dataSources))\n    after(() => closeTestingConnections(dataSources))\n\n    it(\"should do something specific\", () =>\n        Promise.all(\n            dataSources.map(async (dataSource) => {\n                // Test implementation\n            }),\n        ))\n})\n```\n\n", "type": "directive", "topic": "Testing", "enforceability": "content", "context_required": "project"}, {"statement_id": "ffd81d71c1458d176dfb:9:11", "repo": "typeorm/typeorm", "file_path": ".github/copilot-instructions.md", "start_line": "9", "end_line": "11", "text": "## Architecture & Structure\n\n", "type": "description", "topic": "Architecture", "enforceability": "", "context_required": ""}]